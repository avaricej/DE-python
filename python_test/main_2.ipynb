   "source": [
    "import re\n",
    "\n",
    "str = \"Дата события: 2024.12.25 в 14:00\"\n",
    "pattern = re.compile(r'(?P<year>\\d{4})\\.(?P<month>\\d{2})\\.(?P<day>\\d{2}) в (?P<time>\\d{2}:\\d{2})')\n",
    "new_str = re.search(pattern, str)\n",
    "print(new_str.group('year'))\n",
    "print(new_str.group('time'))"
   ]
  }
 ],
